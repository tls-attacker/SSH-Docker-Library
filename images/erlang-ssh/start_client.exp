#!/usr/bin/expect -f

set ip [lindex $argv 0]
set port [lindex $argv 1]
set user [lindex $argv 2]
set password [lindex $argv 3]
set command [lindex $argv 4]

# How to treat a host key that is not in known_hosts: there is no prompt, Erlang decides by its options. Keys in
# known_hosts are trusted either way.
set hostkey_prompt "accept"
if {[info exists env(SSLC_HOSTKEY_PROMPT)]} {
    set hostkey_prompt $env(SSLC_HOSTKEY_PROMPT)
}
switch -- $hostkey_prompt {
    accept { set hostkey_options "{silently_accept_hosts, true}" }
    accept_once { set hostkey_options "{silently_accept_hosts, true}, {save_accepted_host, false}" }
    reject { set hostkey_options "{silently_accept_hosts, false}, {user_interaction, false}" }
    default {
        puts stderr "SSLC_HOSTKEY_PROMPT=$hostkey_prompt is not supported by Erlang/OTP ssh"
        exit 1
    }
}

set timeout 5

spawn /usr/local/bin/erl

expect -re {\d+> $}
send "ssh:start().\r"

expect -re {\d+> $}
send "{ok, S} = ssh:connect(\"$ip\", $port, \[{user, \"$user\"}, {password, \"$password\"}, $hostkey_options, {auth_methods, \"password\"}\]).\r"

expect -re {\d+> $}
send "{ok, Ch} = ssh_connection:session_channel(S, infinity).\r"

expect -re {\d+> $}
send "ssh_connection:exec(S, Ch, \"$command\", infinity).\r"

expect -re {\d+> $}
send "flush().\r"

expect -re {\d+> $}
send "ssh:close(S).\r"

expect -re {\d+> $}
send "init:stop().\r"

expect eof
exit 0
