#!/usr/bin/expect -f

set ip [lindex $argv 0]
set port [lindex $argv 1]
set user [lindex $argv 2]
set password [lindex $argv 3]
set command [lindex $argv 4]

set timeout 5

spawn /usr/local/bin/erl

expect -re {\d+> $}
send "ssh:start().\r"

expect -re {\d+> $}
send "{ok, S} = ssh:connect(\"$ip\", $port, \[{user, \"$user\"}, {password, \"$password\"}, {silently_accept_hosts, true}, {auth_methods, \"password\"}\]).\r"

expect -re {\d+> $}
send "{ok, Ch} = ssh_connection:session_channel(S, infinity).\r"

expect -re {\d+> $}
send "ssh_connection:exec(S, Ch, \"$command\", infinity).\r"

expect -re {\d+> $}
send "flush().\r"

expect -re {\d+> $}
send "ssh:close(S).\r"

expect -re {\d+> $}
send "init:stop().\r"

expect eof
exit 0
